{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "description": "DriverLedger mobile UI (Expo SDK 57+, Expo Router, RxJS, signals, SQLite + Supabase).",
  "main": "index.ts",
  "scripts": {
    "dev": "npx expo start",
    "ios": "npx expo start --ios",
    "android": "npx expo start --android",
    "web": "npx expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tsc": "tsc --noEmit",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "@preact/signals-react": "^3.12.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "react": "^19.1.0",
    "react-native": "^0.81.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.7.0"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.12"
  }
}
